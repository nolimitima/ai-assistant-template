# ============ Telegram (нужен всегда: это панель менеджера) ============
# Токен бота от @BotFather
BOT_TOKEN=
# Твой telegram id (узнать у @userinfobot). Несколько менеджеров — через запятую
ADMIN_ID=
# Контакт, который бот показывает при сбоях: @username или телефон. Можно пусто
SUPPORT_CONTACT=

# ============ Где бот общается с клиентами ============
# Любые из: telegram, whatsapp, instagram — через запятую. Например, только: whatsapp
# Telegram-бот выше нужен в любом случае — это панель менеджера. Если telegram
# здесь нет, клиентам в Telegram бот не отвечает, он только для админов.
# WhatsApp и Instagram требуют сервер и аккаунт Meta — всё в CHANNELS.md
CHANNELS=telegram

# ============ Нейросеть ============
# Одно слово — адрес и модель подставятся сами:
#   deepseek   — самая дешёвая (DeepSeek V4 Flash). Ключ: platform.deepseek.com
#   anthropic  — Claude Haiku: дороже, но строже соблюдает правила. Ключ: console.anthropic.com
#   gemini     — Google Gemini Flash-Lite. Ключ: aistudio.google.com
#   openai     — OpenAI, нужно указать LLM_MODEL. Ключ: platform.openai.com
#   openrouter — сотни моделей через один ключ, нужно указать LLM_MODEL. Ключ: openrouter.ai
# Сравнить модели на своих вопросах: python test_bot.py
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Пусто — модель по умолчанию для провайдера. Свою — точное имя со страницы провайдера
LLM_MODEL=
# Обычно пусто. Нужен, только если провайдер дал особый адрес
LLM_BASE_URL=

# ============ Сервер (только для WhatsApp и Instagram) ============
# Адрес бота в интернете, начинается с https://, без / в конце
PUBLIC_URL=
# Порт веб-сервера по умолчанию 8080. Хостинги вроде Railway задают его сами — сюда не вписывай
# Пароль для проверки вебхука в Meta. Пусто — бот придумает сам (покажет check_setup.py)
META_VERIFY_TOKEN=

# ============ WhatsApp: способ подключения ============
# greenapi — по QR-коду, как WhatsApp Web: 5 минут, без Meta и без сервера.
#            Неофициально: номер могут заблокировать (CHANNELS.md → «WhatsApp через QR-код»)
# meta     — официальный WhatsApp Cloud API: надёжно, но нужен сервер и аккаунт Meta
WHATSAPP_VIA=meta

# --- WhatsApp через QR-код (WHATSAPP_VIA=greenapi) ---
# Из кабинета console.green-api.com → твой инстанс: idInstance, apiTokenInstance, apiUrl
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=https://api.green-api.com
# 1 — если ответишь клиенту сам с телефона, бот замолчит в этом чате. 0 — не замолкать
WHATSAPP_PAUSE_ON_PHONE_REPLY=1
# Секрет в ссылке привязки номера. Пусто — бот придумает сам (ссылка — в команде /whatsapp)
CONNECT_SECRET=

# ============ WhatsApp официально (WHATSAPP_VIA=meta, CHANNELS.md → WhatsApp) ============
WHATSAPP_TOKEN=
# ID номера из WhatsApp → API Setup. Это НЕ сам номер телефона
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret из App settings → Basic
WHATSAPP_APP_SECRET=

# ============ Instagram (CHANNELS.md → Instagram) ============
# Токен из Instagram → API setup with Instagram login. Бот сам продлевает его
INSTAGRAM_TOKEN=
INSTAGRAM_APP_SECRET=

# ============ Выгрузка заявок в CRM или таблицу ============
# Необязательно: сюда прилетает каждая новая заявка как JSON (POST).
# Подключи через n8n, Make или Zapier — и заявки попадут в amoCRM, Bitrix24
# или Google Таблицу без отдельного кода под каждую CRM. Пусто — выгрузка выключена.
# Поля: lead (заявка целиком — всегда), lead_name, lead_phone (+77011234567, если формат
# номера опознан; иначе как написал клиент), lead_request,
# lead_time, lead_parsed_ok (false — заявка оформлена криво, проверь руками),
# channel, name, username, created_at
LEAD_WEBHOOK_URL=

# ============ Поведение ============
# Сколько последних сообщений диалога бот помнит
HISTORY_LIMIT=12
# Сколько вопросов в сутки один клиент может задать ИИ (защита бюджета). 0 — без лимита
DAILY_LIMIT=40
# Через сколько часов клиент, переданный менеджеру, сам возвращается к ИИ. 0 — никогда
HUMAN_TIMEOUT_HOURS=12
# Сколько секунд проходит от вопроса клиента до ответа (эффект «печатает, как человек»).
# 0 — сразу. Если нейросеть думала дольше — бот не ждёт лишнего. Рекомендуем 5–8.
# В Telegram всё это время виден «печатает…», в WhatsApp и Instagram клиент просто ждёт
REPLY_DELAY_SECONDS=0
# Максимальная длина ответа (в токенах) и «креативность» от 0 до 1. Для консультанта — 0.2–0.4
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.3
# Где хранить базу. На Railway с диском: /data/assistant.db
DB_PATH=
